<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Callout</RootNamespace>
    <AssemblyName>Callout</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- AutoCAD API via NuGet — ExcludeAssets="runtime" ngăn copy DLL AutoCAD vào output -->
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="23.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" Version="23.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="23.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Framework References -->
  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- Auto-deploy to ApplicationPlugins Bundle sau mỗi lần Build -->
  <Target Name="DeployBundle" AfterTargets="Build">
    <PropertyGroup>
      <BundlePath>$(AppData)\Autodesk\ApplicationPlugins\Callout.bundle\Contents</BundlePath>
    </PropertyGroup>
    <MakeDir Directories="$(BundlePath)" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(BundlePath)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BundlePath)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ProjectDir)PackageContents.xml" DestinationFolder="$(AppData)\Autodesk\ApplicationPlugins\Callout.bundle" SkipUnchangedFiles="false" />
  </Target>

</Project>